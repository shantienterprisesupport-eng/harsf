# Never commit real secrets. Add only the providers you enable.
# Leave blank for same-origin browser use through the Vite proxy (local or GitHub Codespaces).
VITE_API_BASE_URL=
AI_GATEWAY_PORT=8787
AI_PROVIDER=auto
AI_PROVIDER_ORDER=anthropic,xai,omniroute,openai,deepseek

# OmniRoute smart router (local OpenAI-compatible gateway)
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=
# Set this to a model, alias, wildcard route, or combo configured in OmniRoute.
OMNIROUTE_MODEL=

OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=
XAI_MODEL=grok-4.7
XAI_API_KEY=
ALIBABA_DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
MOONSHOT_API_KEY=
MINIMAX_API_KEY=
HYPERCLOVA_API_KEY=
UPSTAGE_API_KEY=
MCP_GITHUB_TOKEN=
VECTOR_DATABASE_URL=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=all-minilm
