# Never commit real secrets. Add only the providers you enable.
VITE_API_BASE_URL=http://localhost:8787
AI_GATEWAY_PORT=8787
AI_PROVIDER=auto

# OmniRoute smart router (local OpenAI-compatible gateway)
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=
# Set this to a model, alias, wildcard route, or combo configured in OmniRoute.
OMNIROUTE_MODEL=

# Existing direct providers
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=
XAI_MODEL=grok-4.6
XAI_API_KEY=

# Alibaba Cloud Model Studio / Qwen.
# Required: use the OpenAI-compatible base URL for the SAME region/workspace as the API key.
# Example shape: https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
ALIBABA_BASE_URL=
ALIBABA_MODEL=qwen3.8-max
ALIBABA_DASHSCOPE_API_KEY=

# Zhipu / GLM OpenAI-compatible endpoint
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-5.2
ZHIPU_API_KEY=

# Moonshot / Kimi OpenAI-compatible endpoint. Override base URL if your account uses another official region.
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=kimi-k2.6
MOONSHOT_API_KEY=

# MiniMax OpenAI-compatible endpoint
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_API_KEY=

# NAVER Cloud / HyperCLOVA X OpenAI-compatible endpoint
HYPERCLOVA_BASE_URL=https://clovastudio.stream.ntruss.com/v1/openai
HYPERCLOVA_MODEL=HCX-005
HYPERCLOVA_API_KEY=

# Upstage / Solar OpenAI-compatible endpoint
UPSTAGE_BASE_URL=https://api.upstage.ai/v1
UPSTAGE_MODEL=solar-pro4
UPSTAGE_API_KEY=

# Local-only project tools/memory
MCP_GITHUB_TOKEN=
VECTOR_DATABASE_URL=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=all-minilm
