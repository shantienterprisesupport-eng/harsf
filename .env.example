# Never commit real secrets. Add only the provider you enable.
VITE_API_BASE_URL=http://localhost:8787

# Default HARSF coding adapter: free local Ollama.
# SETUP-HARSF.cmd prepares qwen2.5-coder:3b-instruct and writes these values to local .env.
HARSF_MODEL_API_URL=http://127.0.0.1:11434/v1/chat/completions
HARSF_MODEL_API_KEY=ollama
HARSF_MODEL_NAME=qwen2.5-coder:3b-instruct

# Optional cloud-provider variables for future adult/admin-managed integrations.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
ALIBABA_DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
MOONSHOT_API_KEY=
MINIMAX_API_KEY=
HYPERCLOVA_API_KEY=
UPSTAGE_API_KEY=
MCP_GITHUB_TOKEN=
VECTOR_DATABASE_URL=
