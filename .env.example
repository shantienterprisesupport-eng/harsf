# Never commit real secrets. Add only the provider you enable.
VITE_API_BASE_URL=http://localhost:8787

# Default HARSF coding adapter: DeepSeek V4 Flash.
# Keep the API key blank in Git. SETUP-HARSF.cmd writes the real key only to local .env.
HARSF_MODEL_API_URL=https://api.deepseek.com/chat/completions
HARSF_MODEL_API_KEY=
HARSF_MODEL_NAME=deepseek-v4-flash

