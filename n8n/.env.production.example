# Copy this file to .env only on the server that runs n8n.
# Never commit the real .env file.

N8N_HOST=n8n.example.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.example.com/
GENERIC_TIMEZONE=Asia/Kolkata

# Generate strong private values on the server.
N8N_ENCRYPTION_KEY=replace-with-a-long-random-secret
POSTGRES_USER=n8n
POSTGRES_PASSWORD=replace-with-a-strong-random-password
POSTGRES_DB=n8n
