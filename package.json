{
  "name": "harsf-autonomous-ai-company",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "qa": "npm run test && npm run build",
    "doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/harsf-doctor.ps1",
    "ai:gateway": "node server/ai-gateway.mjs",
    "agents:setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-agents.ps1",
    "agents:verify": "powershell -ExecutionPolicy Bypass -File scripts/verify-agents.ps1",
    "agents:run": "powershell -ExecutionPolicy Bypass -Command \"& .\\.venv\\Scripts\\python.exe .\\praison\\ai_company.py\"",
    "agents:run:handoff": "powershell -ExecutionPolicy Bypass -Command \"& .\\.venv\\Scripts\\python.exe .\\praison\\run_handoff.py\"",
    "mcp:run": "powershell -ExecutionPolicy Bypass -Command \"& .\\.venv\\Scripts\\python.exe .\\mcp_server\\harsf_server.py\"",
    "ruflo:doctor": "npx --yes ruflo@latest doctor",
    "ruflo:orchestrate": "node scripts/ruflo-orchestrate.mjs",
    "ruflo:self-test": "node scripts/ruflo-orchestrate.mjs --self-test",
    "n8n:start": "powershell -ExecutionPolicy Bypass -File scripts/start-n8n.ps1",
    "n8n:status": "powershell -ExecutionPolicy Bypass -File scripts/check-n8n.ps1",
    "n8n:import": "node scripts/n8n-import-workflow.mjs",
    "n8n:handoff": "node scripts/n8n-safe-handoff.mjs",
    "n8n:handoff:ruflo": "node scripts/n8n-safe-handoff.mjs --from-ruflo",
    "n8n:self-test": "node scripts/n8n-import-workflow.mjs --self-test && node scripts/n8n-safe-handoff.mjs --self-test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
