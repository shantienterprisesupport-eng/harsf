{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harsf.example/schemas/ad-plan.schema.json",
  "title": "HARSF generated ad plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "language", "goal", "headlines", "descriptions", "keywords", "audience", "platform_recommendations", "safety"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "language": { "type": "string", "minLength": 2, "maxLength": 10 },
    "goal": { "enum": ["business_promo", "channel_growth", "movie_promotion"] },
    "headlines": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": { "type": "string", "minLength": 1, "maxLength": 30 }
    },
    "descriptions": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": { "type": "string", "minLength": 1, "maxLength": 90 }
    },
    "keywords": {
      "type": "array", "minItems": 5, "maxItems": 20, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["text", "match_type"],
        "properties": {
          "text": { "type": "string", "minLength": 1, "maxLength": 80 },
          "match_type": { "enum": ["BROAD", "PHRASE", "EXACT"] }
        }
      }
    },
    "audience": {
      "type": "object", "additionalProperties": false,
      "required": ["age_min", "age_max", "genders", "locations", "languages", "interests", "exclusions"],
      "properties": {
        "age_min": { "type": "integer", "minimum": 18, "maximum": 65 },
        "age_max": { "type": "integer", "minimum": 18, "maximum": 65 },
        "genders": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["all", "female", "male"] } },
        "locations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2, "maxLength": 100 } },
        "languages": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2, "maxLength": 40 } },
        "interests": { "type": "array", "maxItems": 15, "items": { "type": "string", "maxLength": 80 } },
        "exclusions": { "type": "array", "maxItems": 15, "items": { "type": "string", "maxLength": 80 } }
      }
    },
    "platform_recommendations": {
      "type": "array", "minItems": 1, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["platform", "objective", "budget_percent", "cta", "reason"],
        "properties": {
          "platform": { "enum": ["google_ads", "meta_ads"] },
          "objective": { "type": "string", "minLength": 2, "maxLength": 50 },
          "budget_percent": { "type": "integer", "minimum": 0, "maximum": 100 },
          "cta": { "type": "string", "minLength": 2, "maxLength": 30 },
          "reason": { "type": "string", "minLength": 5, "maxLength": 240 }
        }
      }
    },
    "safety": {
      "type": "object", "additionalProperties": false,
      "required": ["regulated_category", "requires_human_review", "notes"],
      "properties": {
        "regulated_category": { "enum": ["none", "housing", "employment", "credit", "politics", "health", "other"] },
        "requires_human_review": { "type": "boolean" },
        "notes": { "type": "array", "items": { "type": "string", "maxLength": 240 } }
      }
    }
  }
}
